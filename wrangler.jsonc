{
  // Configuración del sitio studios903.com en Cloudflare Workers
  "name": "studios903-web",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": { "enabled": true }
}
